<?xml version="1.0" encoding="utf-8"?>
<!-- Quiet, fully rounded clock capsule: one native shape, without a specular rim or shadow. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#10FFFFFF" android:endColor="#0AFFFFFF" />
    <stroke android:width="0.5dp" android:color="#14FFFFFF" />
    <corners android:radius="15dp" />
</shape>

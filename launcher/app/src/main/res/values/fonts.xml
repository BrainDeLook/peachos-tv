<?xml version="1.0" encoding="utf-8"?>
<!-- Static Inter weights: Android caches each resource; no per-view variable font instantiation. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ReferenceType">
    <string name="font_body" translatable="false">@font/inter_regular</string>
    <string name="font_regular" translatable="false">@font/inter_regular</string>
    <string name="font_light" translatable="false">@font/inter_regular</string>
    <string name="font_extralight" translatable="false">@font/inter_regular</string>
    <string name="font_medium" translatable="false">@font/inter_medium</string>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/settings_landing_bg"
    android:paddingStart="40dp" android:paddingEnd="40dp" android:paddingTop="20dp" android:paddingBottom="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:text="@string/first_run_title"
        android:textColor="#FFE8E9EA" android:textSize="32sp" android:fontFamily="@string/font_medium" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="18dp" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center" android:paddingStart="0dp" android:paddingEnd="28dp">
            <FrameLayout android:layout_width="240dp" android:layout_height="240dp"
                android:background="@drawable/settings_landing_tile">
                <ImageView android:layout_width="112dp" android:layout_height="112dp"
                    android:layout_gravity="center" android:src="@drawable/ic_settings_home"
                    android:contentDescription="@string/first_run_title" />
            </FrameLayout>
            <TextView android:id="@+id/firstRunHint" android:layout_width="match_parent"
                android:layout_height="76dp" android:layout_marginTop="26dp"
                android:gravity="center" android:text="@string/first_run_hint"
                android:textColor="#FFC6CCCF" android:textSize="16sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" android:padding="12dp">
            <TextView android:id="@+id/firstRunHome" style="@style/SettingsLandingRow"
                android:layout_height="61dp" android:text="@string/first_run_home" />
            <TextView android:id="@+id/firstRunChannels" style="@style/SettingsLandingRow"
                android:layout_height="61dp" android:text="@string/first_run_channels" />
            <TextView android:id="@+id/firstRunRemote" style="@style/SettingsLandingRow"
                android:layout_height="61dp" android:text="@string/first_run_remote" />
            <TextView android:id="@+id/firstRunDone" style="@style/SettingsLandingRow"
                android:layout_marginTop="22dp" android:layout_height="56dp"
                android:text="@string/first_run_done" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

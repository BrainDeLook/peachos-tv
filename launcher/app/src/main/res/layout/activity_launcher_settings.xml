<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FF101419" android:paddingStart="40dp" android:paddingEnd="40dp" android:paddingTop="28dp" android:paddingBottom="28dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/launcher_settings" android:textColor="#FFFFFFFF" android:textSize="30sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="20dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="220dp" android:layout_height="match_parent" android:orientation="vertical" android:paddingEnd="20dp">
            <TextView android:id="@+id/navDock" android:layout_marginBottom="10dp" android:text="@string/settings_section_dock" style="@style/SettingsRow" android:layout_height="wrap_content" android:minHeight="54dp" android:paddingTop="12dp" android:paddingBottom="12dp" />
            <TextView android:id="@+id/navCards" android:layout_marginBottom="10dp" android:text="@string/settings_section_cards" style="@style/SettingsRow" android:layout_height="wrap_content" android:minHeight="54dp" android:paddingTop="12dp" android:paddingBottom="12dp" />
            <TextView android:id="@+id/navAppearance" android:layout_marginBottom="10dp" android:text="@string/settings_section_appearance" style="@style/SettingsRow" android:layout_height="wrap_content" android:minHeight="54dp" android:paddingTop="12dp" android:paddingBottom="12dp" />
            <TextView android:id="@+id/navRemote" android:layout_marginBottom="10dp" android:text="@string/settings_section_remote" style="@style/SettingsRow" android:layout_height="wrap_content" android:minHeight="54dp" android:paddingTop="12dp" android:paddingBottom="12dp" />
            <TextView android:id="@+id/navSystem" android:layout_marginBottom="10dp" android:text="@string/settings_section_system" style="@style/SettingsRow" android:layout_height="wrap_content" android:minHeight="54dp" android:paddingTop="12dp" android:paddingBottom="12dp" />
        </LinearLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ScrollView android:id="@+id/sectionDock" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="visible">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_section_dock" android:textSize="24sp" android:textColor="#FFFFFFFF" android:layout_marginBottom="12dp" />
                    <TextView android:id="@+id/reorderChoice" style="@style/SettingsRow" android:layout_marginTop="28dp" android:text="@string/reorder" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:text="@string/columns_label" android:textColor="#FFFFFFFF" android:textSize="20sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                        <TextView android:id="@+id/columns4" style="@style/SettingsColumnChoice" android:text="4" />
                        <TextView android:id="@+id/columns5" style="@style/SettingsColumnChoice" android:text="5" />
                        <TextView android:id="@+id/columns6" style="@style/SettingsColumnChoice" android:text="6" />
                        <TextView android:id="@+id/columns7" style="@style/SettingsColumnChoice" android:text="7" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/rowsGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/rows_below_dock_label" android:textColor="#FFFFFFFF" android:textSize="20sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                            <TextView android:id="@+id/rows0" style="@style/SettingsColumnChoice" android:text="0" />
                            <TextView android:id="@+id/rows1" style="@style/SettingsColumnChoice" android:text="1" />
                            <TextView android:id="@+id/rows2" style="@style/SettingsColumnChoice" android:text="2" />
                            <TextView android:id="@+id/rows3" style="@style/SettingsColumnChoice" android:text="3" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
            <ScrollView android:id="@+id/sectionCards" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_section_cards" android:textSize="24sp" android:textColor="#FFFFFFFF" android:layout_marginBottom="12dp" />
                    <TextView android:id="@+id/topShelfChoice" style="@style/SettingsRow" android:layout_marginTop="18dp" android:text="@string/top_shelf" />
                    <TextView android:id="@+id/wallpaperChoice" style="@style/SettingsRow" android:layout_marginTop="28dp" />
                </LinearLayout>
            </ScrollView>
            <ScrollView android:id="@+id/sectionAppearance" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_section_appearance" android:textSize="24sp" android:textColor="#FFFFFFFF" android:layout_marginBottom="12dp" />
                    <TextView android:id="@+id/liquidGlassChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:text="@string/liquid_glass" />
                    <TextView android:id="@+id/animationsChoice" style="@style/SettingsRow" android:layout_marginTop="28dp" />
                    <TextView android:id="@+id/advancedChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/advanced_effects_warning" android:textColor="#FFACB8C1" android:textSize="14sp" />
                    <LinearLayout android:id="@+id/opacityGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="@string/dock_opacity_label" android:textColor="#FFFFFFFF" android:textSize="20sp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                            <TextView android:id="@+id/dock100" style="@style/SettingsColumnChoice" android:text="100%" />
                            <TextView android:id="@+id/dock70" style="@style/SettingsColumnChoice" android:text="70%" />
                            <TextView android:id="@+id/dock50" style="@style/SettingsColumnChoice" android:text="50%" />
                            <TextView android:id="@+id/dock30" style="@style/SettingsColumnChoice" android:text="30%" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:id="@+id/followThemeChoice" style="@style/SettingsRow" android:layout_marginTop="18dp" android:text="@string/follow_theme" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="@string/follow_theme_hint" android:textColor="#FFACB8C1" android:textSize="14sp" />
                </LinearLayout>
            </ScrollView>
            <ScrollView android:id="@+id/sectionRemote" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_section_remote" android:textSize="24sp" android:textColor="#FFFFFFFF" android:layout_marginBottom="12dp" />
                    <TextView android:id="@+id/settingsHoldChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:text="@string/settings_hold_title" />
                    <TextView android:id="@+id/settingsKeyChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:text="@string/settings_key_choose" />
                    <TextView android:id="@+id/controlOverlayChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:text="@string/control_overlay" />
                    <TextView android:id="@+id/settingsHoldHelp" style="@style/SettingsRow" android:layout_height="wrap_content" android:minHeight="64dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:textSize="14sp" android:text="@string/settings_hold_help" />
                    <TextView android:id="@+id/gearHoldChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:text="@string/gear_hold_settings_title" />
                    <TextView android:id="@+id/navigationSoundChoice" style="@style/SettingsRow" android:layout_marginTop="10dp" android:text="@string/navigation_sound" />
                </LinearLayout>
            </ScrollView>
            <ScrollView android:id="@+id/sectionSystem" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/settings_section_system" android:textSize="24sp" android:textColor="#FFFFFFFF" android:layout_marginBottom="12dp" />
                    <TextView android:id="@+id/idleClockChoice" android:text="@string/settings_idle_clock" android:layout_marginTop="10dp" style="@style/SettingsRow" />
                    <TextView android:id="@+id/openOnStartChoice" style="@style/SettingsRow" android:layout_marginTop="28dp" android:visibility="gone" />
                    <TextView android:id="@+id/defaultHomeChoice" style="@style/SettingsRow" android:layout_marginTop="28dp" android:text="@string/home_settings" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="@string/home_settings_help" android:textColor="#FFACB8C1" android:textSize="14sp" />
                    <TextView android:id="@+id/tvSettingsChoice" style="@style/SettingsRow" android:layout_marginTop="18dp" android:text="@string/tv_settings" />
                    <TextView android:id="@+id/versionLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFACB8C1" android:textSize="15sp" android:layout_marginTop="24dp" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
